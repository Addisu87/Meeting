2025-09-26 15:56:20,494 INFO /Library/Frameworks/Python.framework/Versions/3.13/bin/bench --site meeting.localhost execute import frappe

def check_email_config():
    default_outgoing = frappe.db.get_value("Email Account", {"default_outgoing": 1}, "name")
    if not default_outgoing:
        print("No default outgoing email account found.")
    else:
        print(f"Default outgoing email account: {default_outgoing}")

    errors = frappe.get_all("Email Queue", filters={"status": "Error"}, fields=["name", "error"])
    if errors:
        for error in errors:
            print(f"Email Queue: {error.name}, Error: {error.error}")
    else:
        print("No errors found in Email Queue.")

check_email_config()
